# Immich media storage. Change this if the library lives elsewhere.
UPLOAD_LOCATION=/srv/immich/library

# PostgreSQL data storage. Keep this separate from the media library.
DB_DATA_LOCATION=/srv/immich/postgres

# Local timezone used by Immich.
TZ=America/New_York

# Immich image version. Pinning a major version avoids unexpected upgrades.
IMMICH_VERSION=v3

# Database connection settings.
DB_PASSWORD=replace-with-a-strong-unique-password
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
