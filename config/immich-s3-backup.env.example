# Copy this file to /etc/immich-s3-backup.env and set mode 0600.

AWS_PROFILE=immich-backup
AWS_REGION=us-east-1
S3_BUCKET=replace-with-your-immich-backup-bucket
# Optional when credentials are stored outside root's default AWS profile:
# AWS_SHARED_CREDENTIALS_FILE=/etc/immich-s3-backup.aws-credentials

COMPOSE_DIR=/srv/immich
UPLOAD_LOCATION=/srv/immich/library
POSTGRES_CONTAINER=immich_postgres
DB_DATABASE_NAME=immich
DB_USERNAME=postgres

BACKUP_TIMEZONE=America/New_York
STATE_DIR=/var/lib/immich-s3-backup
APT_WAIT_TIMEOUT_SECONDS=7200
POSTGRES_WAIT_TIMEOUT_SECONDS=900
